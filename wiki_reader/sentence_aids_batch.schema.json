{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["aids"],
  "properties": {
    "aids": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "romaji", "english"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "romaji": {"type": "string", "minLength": 1},
          "english": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
